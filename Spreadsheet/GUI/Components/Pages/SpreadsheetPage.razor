@namespace GUI.Components.Pages
@page "/sheets"
@rendermode InteractiveServer
@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime

<PageTitle>Spreadsheet</PageTitle>

<dialog id="alertBox">
  <p>Something happened!</p>
  <button onclick="this.closest('dialog').close()">OK</button>
</dialog>

<span>
    <button class="btn btn-primary" @onclick="SaveFile">Save</button>
    <label>Load</label><InputFile type="file" OnChange="HandleFileChooser" />
    <button class="btn btn-secondary ms-3" @onclick="ToggleDarkMode">@(IsDarkMode ? "☀ Light mode" : "🌙 Dark mode")</button>
</span>

<div>
    <div class="upper-panel">
        Selected: @SelectedCellName
        <input class="form-control" @ref="textInputRef" @bind="FocusedTextInput" @bind:event="oninput" />
        Value: @CellsDisplayStore[SelectedRow, SelectedCol]
    </div>

    <div class="table-container">
        <div class="scrollable">
            <table class="table table-bordered">
                <thead>
                    <tr class="fixed-header">
                        <th scope="col">&nbsp;</th>
                        @for ( int col = 0; col < Cols; col++ )
                        {
                            <th scope="col">@Alphabet[col]</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @for ( int row = 0; row < Rows; row++ )
                    {
                        <tr style="padding:0 !important;">
                            <th style="padding:0 !important;" scope="row" class="fixed-column">@(row + 1)</th>
                            @for ( int col = 0; col < Cols; col++ )
                            {
                                int r = row;
                                int c = col;

                            <td @onclick="() => CellClicked(r, c)"
                                class="@(r == SelectedRow && c == SelectedCol ? "selected-cell" : null)"
                                style="padding:0 !important;">
                                <p class="spreadcell">@CellsDisplayStore[r, c]</p>
                            </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .spreadcell {
        width: 150px;
        height: 40px;
        margin: 0;
        display: flex;
        align-items: center;
        padding-left: 5px;
    }

    td {
        vertical-align: middle;
    }

    .table-container {
        overflow-x: auto;
    }

    .fixed-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--sheet-header-bg) !important;
    }

    .fixed-column {
        position: sticky;
        left: 0;
        z-index: 1;
        background-color: var(--sheet-header-bg) !important;
    }

    .scrollable {
        white-space: nowrap; /* Ensures no line breaks within cells */
        width: 1000px;
        height: 500px;
        margin: -1px;
    }

    .selected-cell {
        position: relative;
    }

    .upper-panel {
        width: 100%;
        flex-direction: grid;
        display: flex;
        padding: 10px;
        align-items: center;
        align-content: center;
        text-align: center;
    }

    .upper-panel .p {
        align-self: center;
        text-align: center;
        width: 150px;
    }

    .selected-cell::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 4px solid #117be5;
        pointer-events: none;
    }

    .form-control {
        width: min(85%, 850px);
        margin-left: 35px;
        margin-right: 35px;
    }

    :root {
        --page-bg: #ffffff;
        --sheet-header-bg: #ffffff;
    }

    html[data-theme="dark"] {
    --dialog-bg: #25282d;
    --dialog-text: #e4e6ea;
    }

    html[data-theme="dark"] {
        color-scheme: dark; /* dark scrollbars, file chooser and form controls */
        --page-bg: #1b1d21;
        --sheet-header-bg: #2b2e33;
    }

    html[data-theme="dark"] body {
        background-color: var(--page-bg);
        color: #e4e6ea;
    }

    html[data-theme="dark"] main a,
    html[data-theme="dark"] main .btn-link {
        color: #6ea8fe;
    }

    html[data-theme="dark"] main .top-row {
        background-color: #25282d;
        border-bottom-color: #3d4148;
    }

    html[data-theme="dark"] .form-control,
    html[data-theme="dark"] .form-control:focus {
        background-color: #25282d;
        color: #e4e6ea;
        border-color: #4a4f57;
    }

    html[data-theme="dark"] dialog {
        background-color: #25282d;
        color: #e4e6ea;
        border: 1px solid #4a4f57;
    }

    html[data-theme="dark"] .table {
        --bs-table-color: #e4e6ea;
        --bs-table-bg: #1b1d21;
        --bs-table-border-color: #4a4f57;
        --bs-table-striped-bg: #25282d;
        --bs-table-hover-bg: #2b2e33;
    }

    /* Table text: white everywhere */
    html[data-theme="dark"] .table,
    html[data-theme="dark"] .table th,
    html[data-theme="dark"] .table td,
    html[data-theme="dark"] .table .spreadcell {
    color: #ffffff !important;
    }
</style>


<script type="text/javascript">
    function showAlert(message) {
        var alertBox = document.getElementById('alertBox');
        if (alertBox) {
            alertBox.querySelector('p').textContent = message;
            alertBox.showModal();
        }
    }

    function focusElement(id) {
        console.log(`looking for: ${id}`);
        var element = document.getElementById(id);
        if (element) {
            console.log(`focusing element: ${id} ${element}`)
            element.focus();
        }
    }

    window.addKeyPressListener = function (dotNetObject) {
        console.log("registering key press event handler");
        document.addEventListener('keydown', function (event) {
            console.log(`got key: ${event.key}`);
            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) {
                event.preventDefault(); // Prevent arrow keys from scrolling
            }
            dotNetObject.invokeMethodAsync('HandleKeyPress', event.key);
        });
    };

    function downloadFile(fileName, fileContent) {
        console.log(`download file ${fileName}`);
        // Create a blob with the file content
        const blob = new Blob([fileContent], { type: "text/plain" });

        // Create a link element
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = fileName;

        // Append the anchor element to the body
        document.body.appendChild(a);

        // Click the link to trigger download
        a.click();

        // Remove the anchor element from the DOM
        document.body.removeChild(a);
    }

</script>